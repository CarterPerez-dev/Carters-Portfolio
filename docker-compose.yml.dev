# ©AngelaMos | 2025
# Dev Compose

services:
  backend:
    container_name: backend_service
    build:
      context: ./backend
      dockerfile: ops/Dockerfile.dev
    ports:
      - "${BACKEND_PORT:-5003}:5000"
    environment:
      - ENVIRONMENT=development
      - PYTHONPYCACHEPREFIX=/app/.cache/pycache
    volumes:
      - ./backend:/app
      - ./conf/nginx/logs:/var/log/nginx
      - ./.cache:/app/.cache
    env_file:
      - .env.dev
    networks:
      - my_network
    depends_on:
      - redis
    restart: unless-stopped

  frontend:
    container_name: frontend_dev
    build:
      context: ./frontend
      dockerfile: ops/Dockerfile.dev
    volumes:
      - ./frontend:/app
      - /app/node_modules
    env_file:
      - .env.dev      
    ports:
      - "${FRONTEND_PORT:-3003}:3000"
    networks:
      - my_network
    restart: unless-stopped

  nginx:
    container_name: nginx_dev
    image: nginx:latest
    ports:
      - "${NGINX_PORT:-8083}:80"
      - "${NGINX_ALT_PORT:-8084}:8080"
    volumes:
      - ./conf/nginx/conf.nginx:/etc/nginx/nginx.conf
      - ./conf/nginx/dev:/etc/nginx/sites-enabled
      - ./conf/nginx/logs:/var/log/nginx/
    networks:
      - my_network
    depends_on:
      - backend
      - frontend
    restart: unless-stopped

  # Optional: Local MongoDB (uncomment if not using Atlas)
  # mongo:
  #   container_name: mongo_service
  #   image: mongo:7.0
  #   ports:
  #     - "${MONGO_PORT:-27017}:27017"
  #   environment:
  #     - MONGO_INITDB_ROOT_USERNAME=admin
  #     - MONGO_INITDB_ROOT_PASSWORD=${MONGO_PASSWORD:-portfolio_mongo_pass}
  #     - MONGO_INITDB_DATABASE=portfolio
  #   volumes:
  #     - mongo_data:/data/db
  #   networks:
  #     - my_network
  #   restart: unless-stopped

  redis:
    container_name: redis_service
    image: redis:7.2
    ports:
      - "${REDIS_PORT:-6382}:6379"
    volumes:
      - ./conf/redis/portfolio.redis:/usr/local/etc/redis/redis.conf
    env_file:
      - .env.dev
    command: ["redis-server", "/usr/local/etc/redis/redis.conf", "--requirepass", "${REDIS_PASSWORD}", "--appendonly", "yes", "--protected-mode", "yes", "--bind", "0.0.0.0"]
    networks:
      - my_network
    restart: always
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 120s
      timeout: 10s
      retries: 3


networks:
  my_network:
    driver: bridge
    ipam:
      driver: default
      config:
        - subnet: 172.28.0.0/16

# Uncomment if using local MongoDB
# volumes:
#   mongo_data:
